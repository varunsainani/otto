# Postgres (Neon). Use the pooled connection string in production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# URLs / CORS
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# LLM provider: groq | gemini. Groq is recommended (its free tier suits a
# multi-call tool-using agent better than Gemini's low free RPM).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Demo account (one-click login)
DEMO_EMAIL=demo@otto.app
DEMO_PASSWORD=demo1234

# Agent guardrails
MAX_AGENT_STEPS=12
DAILY_RUN_LIMIT=40

# Ops
SEED_ON_START=false
ENVIRONMENT=development
